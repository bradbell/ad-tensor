/*
{xrst_begin build_lib usr}
{xrst_spell
    dir
    cpp
    libtorch
    libplugin
    txt
    std
    cout
}

Build an AD Tensor Plugin Library
#################################

Purpose
*******
Source code file generated by :ref:`adfn_src_gen-name` can be
compiled and linked to the current executable using this routine.

Prototype
*********
{xrst_literal ,
    include/ad_tensor/plugin.hpp
    BEGIN_BUILD_LIB , END_BUILD_LIB
}

source_dir
**********
is the directory where the plugin library source code is located.

Source Files
============
All of the \*.cpp files in source_dir are included in the
library generated by build_lib.
Each source file can use functions in other cpp files in the source_dir
as well as the ad_tensor and libtorch libraries.

CMakeLists.txt
==============
A specialized  ``CMakeLists.txt`` file is added to the source_dir directory.

quiet
*****
If quiet is true (false) the build of the library will (will not) generate
information about the build on std::cout.

use_installed_ad_tensor
***********************
If this is true, the installed version of ad_tensor is used
for include files and library dependencies.
Otherwise, the ad_tensor source code repository,
and its build subdirectory,
are used for include files and library dependencies.

Build Directory
***************
The output of this routine is a dynamically linked (shared) library
that is placed in the source_dir/build directory.
The name of the library is plugin_lib.
The complete name of the file corresponding to the library is system dependent.
For example, on Linux the file will be libplugin_lib.so.

{xrst_end build_lib}
------------------------------------------------------------------------------
*/
#include <string>
#include <filesystem>
#include <fstream>
#include <ad_tensor/dev/user_assert.hpp>
//
namespace { // Begin empty namespace
// --------------------------------------------------------------------------
// cmake_lists_txt
const char* cmake_lists_txt = R"|(
#
# print_variable
MACRO(print_variable variable)
    MESSAGE(STATUS "${variable} = ${${variable}}" )
ENDMACRO(print_variable)
#
# project
cmake_minimum_required(VERSION 3.10)
project(plugin_lib)
#
# CXX_STANDARD
set(CMAKE_CXX_STANDARD @CMAKE_CXX_STANDARD@)
set(CMAKE_CXX_STANDARD_REQUIRED ON)
set(CMAKE_CXX_EXTENSIONS OFF)
#
# CMAKE_BUILD_TYPE
set(CMAKE_BUILD_TYPE "@CMAKE_BUILD_TYPE@")
#
# AD_TENSOR_LIBRARY_DIR, AD_TENSOR_INCLUDE_DIR
set(AD_TENSOR_LIBRARY_DIR "@CMAKE_BINARY_DIR@/src")
set(AD_TENSOR_INCLUDE_DIR "@CMAKE_SOURCE_DIR@/include")
#
# AD_TENSOR_LIBRARY
find_library(AD_TENSOR_LIBRARY
    NAME ad_tensor
    PATHS ${AD_TENSOR_LIBRARY_DIR}
)
print_variable(AD_TENSOR_LIBRARY)
if( NOT AD_TENSOR_LIBRARY )
    MESSAGE(FATAL_ERROR
        "Can't find ad_tensor library in the directory\n"
        "${AD_TENSOR_LIBRARY_DIR}"
    )
endif( )
#
# TORCH_INCLUDE_DIRS, TORCH_LIBRARIES, TORCH_CXX_FLAGS
SET(Torch_DIR @Torch_DIR@)
find_package(Torch REQUIRED)
print_variable(TORCH_INCLUDE_DIRS)
print_variable(TORCH_LIBRARIES)
print_variable(TORCH_CXX_FLAGS)
#
# Boost_INCLUDE_DIRS, Boost_LIBRARIES
cmake_policy(SET CMP0167 NEW)
find_package(Boost REQUIRED COMPONENTS filesystem system)
print_variable(Boost_INCLUDE_DIRS)
print_variable(Boost_LIBRARIES)
#
# include_directories
include_directories(
    ${Boost_INCLUDE_DIRS}
    ${TORCH_INCLUDE_DIRS}
    ${AD_TENSOR_INCLUDE_DIR}
)
#
# cpp_files
file(GLOB cpp_files "${CMAKE_SOURCE_DIR}/*.cpp")
#
# plugin_lib
add_library(plugin_lib MODULE ${cpp_files} )
target_link_libraries(plugin_lib
    ${AD_TENSOR_LIBRARY}
    ${Boost_LIBRARIES}
    ${TORCH_LIBRARIES}
)
)|";
// --------------------------------------------------------------------------
// use_installed_ad_tensor_txt
const char* use_installed_ad_tensor_txt =
R"|(set(AD_TENSOR_LIBRARY_DIR  "@CMAKE_INSTALL_PREFIX@/@CMAKE_INSTALL_LIBDIR@")
set(AD_TENSOR_INCLUDE_DIR  "@CMAKE_INSTALL_PREFIX@/@CMAKE_INSTALL_INCLUDEDIR@")
)|";
} // End empty namespace
// --------------------------------------------------------------------------
namespace ad_tensor { namespace plugin { // Begin ad_tensor::plugin
//
// BEGIN_BUILD_LIB
void build_lib(
    const std::string& source_dir              ,
    bool               quiet                   ,
    bool               use_installed_ad_tensor )
{   // END_BUILD_LIB
    //
    // fs, string, user_assert
    namespace fs = std::filesystem;
    using std::string;
    using ad_tensor::dev::user_assert;
    //
    // source_path
    fs::path source_path = source_dir;
    //
    // cmake_file
    string cmake_file = cmake_lists_txt;
    if( use_installed_ad_tensor ) {
        size_t start  = cmake_file.find( "set(AD_TENSOR_LIBRARY_DIR" );
        size_t end    = cmake_file.find( "\n" , start) + 1;
        end           = cmake_file.find( "\n", end) + 1;
        size_t n_char = end - start;
        cmake_file.replace(start, n_char, use_installed_ad_tensor_txt);
    }
    //
    // build_path
    fs::path build_path  = source_path / "build";
    if( ! fs::is_directory(build_path) )
    try {
        fs::create_directory( build_path );
    } catch (const std::exception& e) {
        string msg = "build_lib: Can't create the following directory\n";
        msg += build_path.string() + "\n";
        msg += e.what();
        user_assert(false, msg);
    }
    //
    // current_path
    try {
        fs::current_path(build_path);
    } catch (const std::exception& e) {
        string msg = "build_lib: Can't change current directory to\n";
        msg += build_path.string() + "\n";
        msg += e.what();
        user_assert(false, msg);
    }
    //
    // source_path/CMakeLists.txt
    try {
        std::ofstream file( "../CMakeLists.txt" );
        file << cmake_file;
        file.close();
    } catch (const std::exception& e) {
        string msg = "build_lib: Can't create the file\n";
        msg += source_path.string() + "\n";
        msg += e.what();
        user_assert(false, msg);
    }
    //
    // build_path/CMakeCache.txt
    if( fs::is_directory( build_path / "CMakeCache.txt" ) ) {
        fs::remove( build_path / "CMakeCache.txt" );
    }
    //
    // build_path
    std::string cmake_cmd = "cmake -B . -S ..";
    if( quiet ) {
        cmake_cmd += " --log-level=ERROR";
    }
    int return_code = std::system(cmake_cmd.c_str());
    if( return_code != 0 ) {
        string msg = "build_lib: The following command failed ";
        msg += "in directory " + build_path.string() + "\n";
        msg += cmake_cmd;
        user_assert(false, msg);
    };
    //
    // plugin_lib
    cmake_cmd = "cmake --build .";
    if( quiet ) {
        cmake_cmd += " > /dev/null";
    }
    return_code = std::system( cmake_cmd.c_str() );
    if( return_code != 0 ) {
        string msg = "build_lib: The following command failed ";
        msg += "in directory " + build_path.string() + "\n";
        msg += cmake_cmd;
        user_assert(false, msg);
    }
}
} } // End ad_tensor::plugin
