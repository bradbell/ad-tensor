#include <filesystem>
#include <fstream>
#include <gtest/gtest.h>
//
TEST(tests_plugin, compile) {
    //
    namespace fs = std::filesystem;
    //
    // CMAKE_CURRENT_BINARY_DIR/CMakeLists.txt
    std::string text = R"(
cmake_minimum_required(VERSION 3.10)
project(build_plugin_lib)
#
find_package(Torch REQUIRED)
message(STATUS "TORCH_INCLUDE_DIRS = ${TORCH_INCLUDE_DIRS}")
message(STATUS "TORCH_LIBRARIES = ${TORCH_LIBRARIES}")
#
cmake_policy(SET CMP0167 NEW)
find_package(Boost REQUIRED COMPONENTS filesystem system)
message( STATUS "Boost_INCLUDE_DIRS = ${Boost_INCLUDE_DIRS}" )
message( STATUS "Boost_LIBRARIES = ${Boost_LIBRARIES}" )
#
# include_directories
include_directories(
    ${Boost_INCLUDE_DIRS}
    ${TORCH_INCLUDE_DIRS}
    @CMAKE_SOURCE_DIR@/include
)
#
# plugin_lib
add_library(plugin_lib MODULE
    @CMAKE_CURRENT_SOURCE_DIR@/add_int.cpp
    @CMAKE_CURRENT_SOURCE_DIR@/add_tensor.cpp
)
target_link_libraries(plugin_lib
    ${Boost_LIBRARIES}
    ${TORCH_LIBRARIES}
)
    )";
    //
    //
    try {
        //
        // build_dir
        const char* build_dir = "@CMAKE_CURRENT_BINARY_DIR@/build";
        if( ! fs::is_directory( build_dir ) ) {
            fs::create_directory( build_dir );
        }
        fs::current_path(build_dir);
        std::cout << "current_path = " << fs::current_path() << "\n";
        //
        // ../CMakeLists.txt
        std::ofstream file( "../CMakeLists.txt" );
        file << text;
        file.close();
    } catch(const std::exception& e) {
        EXPECT_TRUE( false );
    }
    //
    // cmake
    int return_code = std::system(
        "cmake -B . -S .. -D Torch_DIR='@Torch_DIR@'"
    );
    EXPECT_EQ(return_code, 0);
    //
    // ninja
    return_code = std::system("cmake --build .");
    EXPECT_EQ(return_code, 0);
}
