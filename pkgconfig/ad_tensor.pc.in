prefix=@CMAKE_INSTALL_PREFIX@
exec_prefix=${prefix}
libdir=${prefix}/@CMAKE_INSTALL_LIBDIR@
includedir=${prefix}/@CMAKE_INSTALL_INCLUDEDIR@

Name: @PROJECT_NAME@
Description: An AD Tensor Tool That Uses Libtorch For Calculations.
Version: @PROJECT_VERSION@
Libs: -L${libdir} -lad_tensor
Cflags: -I${includedir}

